APP_ENV=dev
LOG_LEVEL=INFO
ALLOW_LOCALHOST_FETCH=true
HEARTBEAT_SECONDS=300
# Phase 2
CHAT_SUMMARIZE=true
CHAT_MAX_LEN=2000

# ----- Voice behavior -----
VOICE_DEFAULT_ENGINE=pyttsx3
VOICE_DEFAULT_VOICE=HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Speech\Voices\Tokens\TTS_MS_EN-US_ZIRA_11.0

VOICE_MAX_FILES=300
VOICE_MAX_AGE_HOURS=72

VOICE_PRE_DEFAULT_TONE=soft
VOICE_DEFAULT_SSML_RATE=+0%
VOICE_DEFAULT_SSML_PITCH=+0st
VOICE_DEFAULT_PAUSE_MS=140
SEED_SASS=1
VOICE_ALLOW_OVERRIDE=false



# ----- Voice history -----
VOICE_HISTORY_SIZE=200
VOICE_HISTORY_LOG=voice_history.json

# ----- Voice + FFmpeg options -----
VOICE_FFMPEG_ENABLE=1             # 1=on, 0=off
VOICE_FFMPEG_TARGET=mp3           # mp3 | wav | ogg | m4a
VOICE_FFMPEG_BITRATE=192k         # 128k, 192k, 256k, 320k...
VOICE_FFMPEG_ARGS=-af loudnorm=I=-16:TP=-1.5:LRA=11,aresample=48000
VOICE_FFMPEG_DUAL_OUT=0           # 1 = keep both WAV and MP3 (optional)
VOICE_PRE_ENABLE=1
VOICE_PRE_REMOVE_EMOJI=1
VOICE_PRE_MAX_ELLIPSIS_BREAK_MS=400
VOICE_PRE_SENTENCE_BREAK_MS=220
VOICE_PRE_COMMA_BREAK_MS=120
VOICE_PRE_DEFAULT_TONE=neutral   # neutral|soft|warm|bright
VOICE_PRE_STRICT_QUOTES=1
